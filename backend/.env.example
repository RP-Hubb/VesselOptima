# VesselOptima Environment Configuration
# Copy to .env and fill in values

# Runtime mode: LIVE or OFFLINE_DEMO (no other values accepted)
RUNTIME_MODE=OFFLINE_DEMO

# Database
DATABASE_URL=sqlite:///./vesseloptima.db
# For PostgreSQL:
# DATABASE_URL=postgresql://vesseloptima:password@localhost:5432/vesseloptima

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Offline data package path (used only in OFFLINE_DEMO mode)
OFFLINE_PACKAGE_DIR=../data/offline/packages

# Model artifacts path
MODEL_ARTIFACTS_DIR=../models
